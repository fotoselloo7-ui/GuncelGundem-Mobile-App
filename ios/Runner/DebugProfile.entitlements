<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Debug/Profile derlemelerinde yalnız development AASA erişimi için
         ?mode=developer eklemek yeterlidir; manifest yoksa evrensel link
         açılmaz — uygulamayı etkilemez. -->
    <key>com.apple.developer.associated-domains</key>
    <array>
        <string>applinks:guncelgundem.tr</string>
    </array>
    <key>com.apple.security.get-task-allow</key>
    <true/>
</dict>
</plist>
