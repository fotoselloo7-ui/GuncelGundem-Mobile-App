<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- iOS Universal Links: guncelgundem.tr altındaki KANONİK içerik yolları
         (/haber/* ve /blog/*) native uygulamada açılır. Yasal sayfalar
         (/kvkk/, /gizlilik-politikasi/, /kullanim-sartlari/, /cerez-politikasi/)
         uygulamaya alınmaz; Safari'de açılır. Yol kapsamı sunucudaki AASA
         dosyasının "paths" alanıyla sınırlanır:
         https://guncelgundem.tr/.well-known/apple-app-site-association
         (Bkz. IOS-RELEASE-HANDOFF.md — AASA Apple Team ID gerektirir.) -->
    <!-- Push capability: Debug=development, Release/Profile=production.
         Apple Developer App ID/provisioning must also enable Push Notifications. -->
    <key>aps-environment</key>
    <string>$(APS_ENVIRONMENT)</string>
    <key>com.apple.developer.associated-domains</key>
    <array>
        <string>applinks:guncelgundem.tr</string>
    </array>
</dict>
</plist>
